{
  "izlenen_klasorler": [
    "$XDG_DOWNLOAD"
  ],
  "tarama_araligi_saniye": 3,
  "sabit_kalma_suresi_saniye": 5,
  "baslangicta_mevcut_dosyalari_duzenle": false,
